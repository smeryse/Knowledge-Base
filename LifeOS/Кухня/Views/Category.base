filters:
  and:
    - type == "category"
views:
  - type: cards
    name: Карточки
    order:
      - file.name
    sort:
      - property: file.name
        direction: ASC
    markers: number
    indentProperties: false
  - type: table
    name: Таблица
    order:
      - file.name
      - title
      - aliases
      - created
    sort:
      - property: aliases
        direction: DESC
      - property: file.name
        direction: ASC
    columnSize:
      file.name: 200
      note.title: 200
      note.aliases: 200
      note.created: 100
  - type: table
    name: Без товаров
    order:
      - file.name
      - title
      - aliases
    sort:
      - property: file.name
        direction: ASC
    columnSize:
      file.name: 200
      note.title: 200
      note.aliases: 200
